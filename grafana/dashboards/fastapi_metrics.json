{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "type": "dashboard",
        "name": "Annotations & Alerts",
        "enabled": true
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "handler",
        "type": "query",
        "datasource": "prometheus",
        "query": "label_values(http_requests_total{handler!=\"/metrics\"}, handler)",
        "refresh": 1,
        "includeAll": true,
        "multi": true
      }
    ]
  },
  "panels": [
    {
      "type": "graph",
      "title": "Request Latency (p95)",
      "datasource": "prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{handler!=\"/metrics\", handler=~\"$handler\"}[1m])) by (le, handler))",
          "legendFormat": "{{handler}}",
          "refId": "A"
        }
      ],
      "lines": true,
      "points": false,
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 }
    },
    {
      "type": "graph",
      "title": "Request Throughput (req/s)",
      "datasource": "prometheus",
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{handler!=\"/metrics\", handler=~\"$handler\"}[1m])) by (handler)",
          "legendFormat": "{{handler}}",
          "refId": "B"
        }
      ],
      "lines": true,
      "points": false,
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 }
    },
    {
      "type": "graph",
      "title": "CPU Usage",
      "datasource": "prometheus",
      "targets": [
        {
          "expr": "process_cpu_seconds_total",
          "legendFormat": "CPU seconds",
          "refId": "C"
        }
      ],
      "lines": true,
      "points": false,
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 }
    },
    {
      "type": "graph",
      "title": "Memory Usage (bytes)",
      "datasource": "prometheus",
      "targets": [
        {
          "expr": "process_resident_memory_bytes",
          "legendFormat": "Memory",
          "refId": "D"
        }
      ],
      "lines": true,
      "points": false,
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 }
    },
    {
      "type": "graph",
      "title": "HTTP Status Codes per Endpoint",
      "datasource": "prometheus",
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{handler!=\"/metrics\", handler=~\"$handler\"}[1m])) by (handler, status)",
          "legendFormat": "{{handler}} - {{status}}",
          "refId": "E"
        }
      ],
      "lines": true,
      "points": false,
      "gridPos": { "x": 0, "y": 16, "w": 24, "h": 8 }
    },
    {
      "type": "graph",
      "title": "5xx Error Rate by Handler",
      "datasource": "prometheus",
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{handler!=\"/metrics\", status=~\"5..\", handler=~\"$handler\"}[1m])) by (handler)",
          "legendFormat": "{{handler}}",
          "refId": "F"
        }
      ],
      "lines": true,
      "points": false,
      "gridPos": { "x": 0, "y": 24, "w": 24, "h": 8 }
    },
    {
      "type": "graph",
      "title": "4xx Error Rate by Handler",
      "datasource": "prometheus",
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{handler!=\"/metrics\", status=~\"4..\", handler=~\"$handler\"}[1m])) by (handler)",
          "legendFormat": "{{handler}}",
          "refId": "F"
        }
      ],
      "lines": true,
      "points": false,
      "gridPos": { "x": 0, "y": 24, "w": 24, "h": 8 }
    }    
  ],
  "schemaVersion": 36,
  "title": "FastAPI Metrics",
  "version": 3,
  "timezone": "browser",
  "uid": "fastapi-dashboard"
}
