            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "scrape_series_added{job=~\"$job\"}",
          "legendFormat": "{{job}} — {{instance}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "New series per scrape",
