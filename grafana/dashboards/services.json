    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "The FastAPI app exposes four latency buckets — 0.1, 0.5, 1.0 and +Inf — so any route slower than one second lands in +Inf and this panel reads a flat 1s for it. Measured 2026-08-23: /load/io-bound takes 2s and reads 1s here. Widening the buckets is an instrumentation change and is deliberately outside this dashboard. Grouped by job so that bucket sets from different services are never summed. The app publishes four bounds and the Go service twelve, and the app's four are a subset of them — so a merged sum would carry bounds the app never reports, every bucket below 0.1 would count one service only, and the quantile would describe neither.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 8,
            "lineWidth": 1,
            "showPoints": "never"
          },
          "min": 0,
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 18
      },
      "id": 9,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, job, handler) (rate(http_request_duration_seconds_bucket{job=~\"$job\", handler!=\"\", handler=~\"$handler\", handler!=\"/metrics\"}[$__rate_interval])))",
          "legendFormat": "{{job}} — {{handler}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "p95 by route",
      "type": "timeseries"
    },
