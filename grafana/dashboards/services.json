    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Samples the drop rules threw away, per scrape: what the target emitted minus what was stored. Flat zero everywhere is the healthy reading — a line above it is a service labelling series with a raw path.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
