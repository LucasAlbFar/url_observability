          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, job, http_route) (rate(traces_span_metrics_duration_seconds_bucket{job=~\"$job\", http_route=~\"$http_route\"}[$__rate_interval])))",
          "legendFormat": "{{job}} — {{http_route}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "p95 by route",
      "type": "timeseries"
