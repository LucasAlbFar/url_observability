    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "One bucket list for all three services, defined in the Collector's connector. It replaces the app's four bounds against the Go service's twelve, and with them the flat 1s this panel read for every route slower than a second. Still grouped by job: merging bucket sets across services is what produced bounds a service never reported.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 8,
            "lineWidth": 1,
            "showPoints": "never"
          },
          "min": 0,
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 18
      },
      "id": 9,
      "options": {
