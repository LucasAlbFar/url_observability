{
  // Prose in this repo is written one paragraph per line, which keeps diffs
  // readable. MD013 (line-length) would force rewrapping every documentation
  // file, so it is off. Every other default rule stays on.
  "default": true,
  "MD013": false,

  // MD060 defaults to "any", which only asks each table to be internally
  // consistent -- a new table written entirely tight would pass. Pinning
  // "compact" holds every table in the repo to one style.
  "MD060": { "style": "compact" }
}
